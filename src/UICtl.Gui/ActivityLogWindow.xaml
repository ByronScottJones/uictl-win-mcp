<Window x:Class="UICtl.Gui.ActivityLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="uictl Activity Log"
        Width="960" Height="420"
        WindowStartupLocation="CenterScreen">
    <DockPanel LastChildFill="True" Margin="10">
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="Gray" Margin="0,0,6,0"/>
                <TextBlock x:Name="BannerText" Text="Idle" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="ExportButton" Content="Export JSON…" Padding="10,4" Click="ExportButton_Click" DockPanel.Dock="Right"/>
            <CheckBox x:Name="GateCheckBox" Content="Commands enabled" IsChecked="True" VerticalAlignment="Center"
                      Margin="0,0,16,0" Checked="GateCheckBox_Changed" Unchecked="GateCheckBox_Changed" DockPanel.Dock="Right"/>
        </DockPanel>
        <DataGrid x:Name="Grid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionUnit="Cell"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#11000000">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="90"/>
                <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="140"/>
                <DataGridTextColumn Header="OK" Binding="{Binding OkText}" Width="40"/>
                <DataGridTextColumn Header="ms" Binding="{Binding DurationText}" Width="60"/>
                <DataGridTextColumn Header="Params" Binding="{Binding ParamsSummary}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding ParamsSummary}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Response" Binding="{Binding ResponseSummary}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding ResponseSummary}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
