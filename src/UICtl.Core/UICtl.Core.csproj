<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.Core" Version="5.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UICtl.Core.Tests" />
    <!-- Lets the GUI project reuse AppsAndWindows.BringToFront (its own
         window needs the same reliable foreground-raising trick as every
         other window uictl activates) and the raw cursor-position P/Invoke
         for toast placement, without making either public API surface. -->
    <InternalsVisibleTo Include="UICtl.Gui" />
  </ItemGroup>

</Project>
